#!/bin/bash
# Mouse Jumper+ on Mint: the server and the Reader+ agent, one copy each per desktop session.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/mjp-server.lock"
flock -n 9 || exit 0
( while true; do python3 $HOME/.local/bin/mjp_reader.py; sleep 3; done ) &
while true; do
  python3 $HOME/.local/bin/mjp_server.py
  sleep 2
done
